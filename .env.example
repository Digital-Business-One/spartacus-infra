# ─── Docker Compose (emulators + backend) ────────────────────────────────────
# Copy to .env and fill in values:
#   cp .env.example .env

# Firebase project ID (also used as ROOT_PROJECT_ID)
FIREBASE_PROJECT_ID=spartacus-artes-marciais
ROOT_PROJECT_ID=spartacus-artes-marciais

# SendGrid — required for send_email Cloud Function (even in local emulator)
# Get your key at https://app.sendgrid.com/settings/api_keys
SENDGRID_API_KEY=

# Base URL of the Expo web app — used to build branded password-reset links.
# Local:  http://localhost:8081 (Expo web default)
# Prod:   https://app.spartacus.app.br (set in Cloud Run env, not here)
APP_WEB_URL=http://localhost:8081
