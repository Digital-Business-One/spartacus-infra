rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Public read — classes listed on the landing page without auth
    match /classes/{classId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Projects — public read (name, logo, mission visible on landing page)
    match /projects/{projectId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Users — only the owner can read/write their own document
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Memberships — authenticated reads; writes via backend only (Admin SDK)
    match /memberships/{membershipId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // All other collections — authenticated reads, no client writes
    match /{document=**} {
      allow read: if request.auth != null;
      allow write: if false;
    }

  }
}
